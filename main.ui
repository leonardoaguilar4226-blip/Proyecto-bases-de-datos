  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-color: #f8fafc;
}

#barra {
    background-color: qlineargradient(
        spread:pad,
        x1:0, y1:0,
        x2:1, y2:0,
        stop:0 #4c1d95,
        stop:0.55 #9333ea,
        stop:1 #db2777
    );
    border-bottom: 1px solid rgba(255, 255, 255, 90);
}

#titulo {
    color: white;
    font-size: 26px;
    font-weight: bold;
}

#saludo {
    color: white;
    font-size: 14px;
    font-weight: bold;
}

#rol {
    color: #f5d0fe;
    font-size: 13px;
    font-weight: bold;
}

#btnCerrarSesion {
    background-color: rgba(255, 255, 255, 35);
    color: white;
    border: 2px solid rgba(255, 255, 255, 120);
    border-radius: 11px;
    font-size: 12px;
    font-weight: bold;
}

#btnCerrarSesion:hover {
    background-color: white;
    color: #7e22ce;
}

#btnCerrarSesion:pressed {
    background-color: #f3e8ff;
}

#btnMenuEmpleados {
    background-color: #a779e8;
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
}

#btnMenuEmpleados:hover {
    background-color: #9666df;
}

#btnMenuAlumnos {
    background-color: #3498db;
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
}

#btnMenuAlumnos:hover {
    background-color: #2f89c5;
}

#btnMenuLibros {
    background-color: #10b981;
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
}

#btnMenuLibros:hover {
    background-color: #059669;
}

#btnMenuProfesores {
    background-color: #22c55e;
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
}

#btnMenuProfesores:hover {
    background-color: #16a34a;
}

#btnMenuPrestamos {
    background-color: #f59e0b;
    color: white;
    border: none;
    border-radius: 9px;
    font-size: 13px;
    font-weight: bold;
}

#btnMenuPrestamos:hover {
    background-color: #d97706;
}

#panelEmpleados {
    background-color: white;
    border: 2px solid #a779e8;
    border-top: none;
    border-radius: 0px;
}

#panelAlumnos {
    background-color: white;
    border: 2px solid #3498db;
    border-top: none;
    border-radius: 0px;
}

#panelLibros {
    background-color: white;
    border: 2px solid #10b981;
    border-top: none;
    border-radius: 0px;
}

#panelProfesores {
    background-color: white;
    border: 2px solid #22c55e;
    border-top: none;
    border-radius: 0px;
}

#panelPrestamos {
    background-color: white;
    border: 2px solid #f59e0b;
    border-top: none;
    border-radius: 0px;
}

#panelEmpleados QPushButton,
#panelAlumnos QPushButton,
#panelLibros QPushButton,
#panelProfesores QPushButton,
#panelPrestamos QPushButton {
    background-color: transparent;
    color: #241236;
    border: none;
    text-align: left;
    padding-left: 32px;
    font-size: 13px;
    font-weight: bold;
}

#panelEmpleados QPushButton:hover {
    background-color: #f3e8ff;
    color: #6d28d9;
}

#panelAlumnos QPushButton:hover {
    background-color: #e0f2fe;
    color: #0369a1;
}

#panelLibros QPushButton:hover {
    background-color: #d1fae5;
    color: #047857;
}

#panelProfesores QPushButton:hover {
    background-color: #dcfce7;
    color: #15803d;
}

#panelPrestamos QPushButton:hover {
    background-color: #fef3c7;
    color: #b45309;
}

#panelEmpleados QPushButton:pressed,
#panelAlumnos QPushButton:pressed,
#panelLibros QPushButton:pressed,
#panelProfesores QPushButton:pressed,
#panelPrestamos QPushButton:pressed {
    background-color: #ede9fe;
}
</string>
