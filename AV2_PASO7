class ConsultaIndividual(QDialog):
    def __init__(self, tabla):
        super().__init__()
        self.tabla_nombre = tabla

        self.setWindowTitle("Consulta Individual")
        self.resize(400, 200)

        layout = QtWidgets.QVBoxLayout()

        self.input_codigo = QtWidgets.QLineEdit()
        self.input_codigo.setPlaceholderText("Ingrese código")

        self.btn_buscar = QtWidgets.QPushButton("Buscar")
        self.btn_buscar.clicked.connect(self.buscar)

        self.resultado = QtWidgets.QTextEdit()
        self.resultado.setReadOnly(True)

        layout.addWidget(self.input_codigo)
        layout.addWidget(self.btn_buscar)
        layout.addWidget(self.resultado)

        self.setLayout(layout)

    def buscar(self):
        codigo = self.input_codigo.text()

        try:
            query = f"SELECT * FROM {self.tabla_nombre} WHERE codigo = %s"
            cursor.execute(query, (codigo,))
            fila = cursor.fetchone()

            if fila:
                self.resultado.setText(str(fila))
            else:
                self.resultado.setText("No encontrado")

        except Exception as e:
            QtWidgets.QMessageBox.warning(self, "Error", str(e))

class EditarRegistro(QDialog):
    def __init__(self, tabla):
        super().__init__()
        self.tabla_nombre = tabla

        self.setWindowTitle("Editar Registro")
        self.resize(400, 300)

        layout = QtWidgets.QVBoxLayout()

        self.input_codigo = QtWidgets.QLineEdit()
        self.input_codigo.setPlaceholderText("Código a editar")

        self.input_nombre = QtWidgets.QLineEdit()
        self.input_nombre.setPlaceholderText("Nuevo nombre")

        self.btn_actualizar = QtWidgets.QPushButton("Actualizar")
        self.btn_actualizar.clicked.connect(self.actualizar)

        layout.addWidget(self.input_codigo)
        layout.addWidget(self.input_nombre)
        layout.addWidget(self.btn_actualizar)

        self.setLayout(layout)

    def actualizar(self):
        try:
            cursor.execute(
                f"UPDATE {self.tabla_nombre} SET nombre = %s WHERE codigo = %s",
                (self.input_nombre.text(), int(self.input_codigo.text()))
            )
            conexion.commit()

            QtWidgets.QMessageBox.information(self, "Éxito", "Registro actualizado")
            self.close()

        except Exception as e:
            conexion.rollback()
            QtWidgets.QMessageBox.warning(self, "Error", str(e))

class EliminarRegistro(QDialog):
    def __init__(self, tabla):
        super().__init__()
        self.tabla_nombre = tabla

        self.setWindowTitle("Eliminar Registro")
        self.resize(300, 150)

        layout = QtWidgets.QVBoxLayout()

        self.input_codigo = QtWidgets.QLineEdit()
        self.input_codigo.setPlaceholderText("Código a eliminar")

        self.btn_eliminar = QtWidgets.QPushButton("Eliminar")
        self.btn_eliminar.clicked.connect(self.eliminar)

        layout.addWidget(self.input_codigo)
        layout.addWidget(self.btn_eliminar)

        self.setLayout(layout)

    def eliminar(self):
        codigo = self.input_codigo.text()

        confirmacion = QtWidgets.QMessageBox.question(
            self,
            "Confirmar",
            f"¿Seguro que deseas eliminar el código {codigo}?",
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No
        )

        if confirmacion == QtWidgets.QMessageBox.Yes:
            try:
                cursor.execute(
                    f"DELETE FROM {self.tabla_nombre} WHERE codigo = %s",
                    (codigo,)
                )
                conexion.commit()

                QtWidgets.QMessageBox.information(self, "Éxito", "Registro eliminado")
                self.close()

            except Exception as e:
                conexion.rollback()
                QtWidgets.QMessageBox.warning(self, "Error", str(e))



